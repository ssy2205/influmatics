{
  "hosting": {
    "public": "web/frontend/dist",
    "predeploy": ["npm --prefix web/frontend run build"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/research/",
        "type": 302
      }
    ],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
